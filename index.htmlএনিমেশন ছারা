<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Pixel SVG Animator</title>
  <style>
    :root {
      --bg-dark: #121318;
      --bg-card: #1c1e24;
      --bg-hover: #2a2d37;
      --border: #2e323e;
      --accent: #6366f1;
      --accent-hover: #4f46e5;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --danger: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 12px;
      touch-action: manipulation;
    }

    header {
      width: 100%;
      max-width: 900px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }

    h1 {
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--accent);
    }

    .container {
      width: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    @media (min-width: 768px) {
      .container {
        display: grid;
        grid-template-columns: 1fr 340px;
        align-items: start;
      }
      .editor-column {
        grid-column: 1;
      }
      .sidebar-column {
        grid-column: 2;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
    }

    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .card-title {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      margin-bottom: 8px;
      font-weight: 600;
    }

    /* Controls & Buttons */
    .btn-group {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    btn, button, .btn {
      background-color: var(--bg-hover);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: background-color 0.15s, border-color 0.15s;
    }

    button:hover, .btn:hover {
      background-color: #353946;
    }

    button.active {
      background-color: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    button.danger {
      background-color: rgba(239, 68, 68, 0.2);
      border-color: var(--danger);
      color: var(--danger);
    }

    button.danger:hover {
      background-color: var(--danger);
      color: #fff;
    }

    input[type="text"], input[type="number"], select {
      background-color: var(--bg-dark);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
      width: 100%;
    }

    /* Grid Display */
    .canvas-container {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      max-width: 450px;
      margin: 0 auto;
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
      background-image: 
        linear-gradient(45deg, #252830 25%, transparent 25%), 
        linear-gradient(-45deg, #252830 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, #252830 75%), 
        linear-gradient(-45deg, transparent 75%, #252830 75%);
      border: 2px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
      touch-action: none;
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
    }

    #editorCanvas {
      z-index: 2;
    }

    #onionCanvas {
      z-index: 1;
      opacity: 0.3;
    }

    .stats-bar {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 6px;
    }

    /* Inspector & Tools */
    .tool-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 10px;
    }

    .color-picker-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 8px;
    }

    input[type="color"] {
      -webkit-appearance: none;
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      cursor: pointer;
      background: transparent;
    }

    input[type="color"]::-webkit-color-swatch-wrapper {
      padding: 0;
    }

    input[type="color"]::-webkit-color-swatch {
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    .palette {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .swatch {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      border: 1px solid var(--border);
      cursor: pointer;
    }

    /* Timeline */
    .timeline {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 8px 0;
    }

    .frame-thumb {
      flex: 0 0 54px;
      height: 54px;
      border: 2px solid var(--border);
      border-radius: 4px;
      background-size: 8px 8px;
      background-image: 
        linear-gradient(45deg, #252830 25%, transparent 25%), 
        linear-gradient(-45deg, #252830 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, #252830 75%), 
        linear-gradient(-45deg, transparent 75%, #252830 75%);
      position: relative;
      cursor: pointer;
    }

    .frame-thumb.active {
      border-color: var(--accent);
    }

    .frame-thumb canvas {
      width: 100%;
      height: 100%;
    }

    .frame-thumb .frame-num {
      position: absolute;
      bottom: 2px;
      right: 2px;
      background: rgba(0,0,0,0.7);
      font-size: 0.6rem;
      padding: 1px 3px;
      border-radius: 2px;
    }

    /* Code View */
    textarea {
      width: 100%;
      height: 100px;
      background-color: var(--bg-dark);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: monospace;
      font-size: 0.75rem;
      border-radius: 6px;
      padding: 6px;
      resize: vertical;
    }

    .preview-box {
      width: 100px;
      height: 100px;
      border: 1px solid var(--border);
      border-radius: 4px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      background-size: 10px 10px;
      background-image: 
        linear-gradient(45deg, #252830 25%, transparent 25%), 
        linear-gradient(-45deg, #252830 25%, transparent 25%), 
        linear-gradient(45deg, transparent 75%, #252830 75%), 
        linear-gradient(-45deg, transparent 75%, #252830 75%);
    }

    .preview-box svg, .preview-box img {
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
    }

    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background-color: var(--accent);
      color: white;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
      z-index: 100;
    }

    .toast.show {
      opacity: 1;
    }
  </style>
</head>
<body>

  <header>
    <h1>Pixel SVG Animator</h1>
    <div class="btn-group">
      <button id="saveProjBtn">Save</button>
      <button id="loadProjBtn">Load</button>
      <input type="file" id="projInput" accept=".json" style="display:none">
    </div>
  </header>

  <div class="container">
    <div class="editor-column">
      <div class="card">
        <div class="canvas-container">
          <canvas id="onionCanvas"></canvas>
          <canvas id="editorCanvas"></canvas>
        </div>
        <div class="stats-bar">
          <span id="coordDisplay">X: -- Y: --</span>
          <span id="pixelStats">PIXELS: 0 / 576</span>
        </div>
      </div>

      <div class="card" style="margin-top: 12px;">
        <div class="card-title">Timeline</div>
        <div class="timeline" id="timeline"></div>
        <div class="btn-group" style="margin-top: 8px;">
          <button id="addFrameBtn">+ Blank</button>
          <button id="dupFrameBtn">+ Duplicate</button>
          <button id="delFrameBtn" class="danger">Delete</button>
          <button id="onionBtn">Onion: OFF</button>
        </div>
        <div class="btn-group" style="margin-top: 8px; align-items: center;">
          <button id="playBtn">Play</button>
          <label style="font-size: 0.8rem; margin-left: 8px;">FPS:</label>
          <select id="fpsSelect" style="width: auto;">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="4">4</option>
            <option value="6">6</option>
            <option value="8">8</option>
            <option value="10" selected>10</option>
            <option value="12">12</option>
            <option value="15">15</option>
            <option value="24">24</option>
          </select>
        </div>
      </div>
    </div>

    <div class="sidebar-column">
      <div class="card">
        <div class="card-title">Setup & Import</div>
        <div style="display: flex; gap: 6px; margin-bottom: 8px;">
          <select id="gridSizeSelect">
            <option value="8">8 x 8</option>
            <option value="16">16 x 16</option>
            <option value="24" selected>24 x 24</option>
            <option value="32">32 x 32</option>
          </select>
          <button id="fileTriggerBtn">Upload File</button>
          <input type="file" id="fileInput" accept="image/png, image/svg+xml" style="display:none">
        </div>
      </div>

      <div class="card">
        <div class="card-title">Tools</div>
        <div class="tool-grid">
          <button id="pencilBtn" class="active">Pencil</button>
          <button id="eraserBtn">Eraser</button>
          <button id="pickerBtn">Picker</button>
        </div>
        <div class="btn-group" style="margin-bottom: 12px;">
          <button id="undoBtn">Undo</button>
          <button id="redoBtn">Redo</button>
          <button id="clearBtn">Clear</button>
        </div>

        <div class="card-title">Color Inspector</div>
        <div class="color-picker-row">
          <input type="color" id="nativeColor" value="#ff0055">
          <input type="text" id="hexInput" value="#FF0055" maxlength="7">
        </div>
        <div style="margin-bottom: 8px;">
          <label style="font-size: 0.75rem; color: var(--text-muted);">Opacity: <span id="opacityVal">100%</span></label>
          <input type="range" id="opacitySlider" min="0" max="100" value="100" style="width: 100%;">
        </div>
        <div class="palette" id="recentPalette"></div>
      </div>

      <div class="card">
        <div class="card-title">Color Reduction</div>
        <div style="display: flex; gap: 6px;">
          <select id="colorReduceCount">
            <option value="2">2 Colors</option>
            <option value="4">4 Colors</option>
            <option value="8" selected>8 Colors</option>
            <option value="16">16 Colors</option>
          </select>
          <button id="reduceColorsBtn">Apply</button>
        </div>
      </div>

      <div class="card">
        <div class="card-title">SVG Output</div>
        <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 8px;">
          <div class="preview-box" id="svgPreviewContainer"></div>
          <div style="flex: 1; display: flex; flex-direction: column; gap: 4px;">
            <button id="generateSvgBtn">Generate SVG</button>
            <button id="copySvgBtn">Copy Code</button>
            <button id="downloadSvgBtn">Download</button>
          </div>
        </div>
        <textarea id="svgOutput" readonly placeholder="Click 'Generate SVG' to produce animated standalone code..."></textarea>
      </div>
    </div>
  </div>

  <div class="toast" id="toast">Message</div>

  <script>
    // --- APP STATE ---
    const state = {
      width: 24,
      height: 24,
      fps: 10,
      activeFrameIndex: 0,
      frames: [], // Array of 2D arrays: null or { color: '#HEX', opacity: 0..1 }
      activeTool: 'pencil', // pencil, eraser, picker
      currentColor: '#FF0055',
      currentOpacity: 1.0,
      onionSkin: false,
      isPlaying: false,
      playInterval: null,
      history: [],
      historyIndex: -1,
      maxHistory: 50,
      recentColors: ['#FF0055', '#00FFcc', '#FFcc00', '#000000', '#FFFFFF']
    };

    // --- DOM ELEMENTS ---
    const editorCanvas = document.getElementById('editorCanvas');
    const editorCtx = editorCanvas.getContext('2d');
    const onionCanvas = document.getElementById('onionCanvas');
    const onionCtx = onionCanvas.getContext('2d');
    
    const pencilBtn = document.getElementById('pencilBtn');
    const eraserBtn = document.getElementById('eraserBtn');
    const pickerBtn = document.getElementById('pickerBtn');
    const undoBtn = document.getElementById('undoBtn');
    const redoBtn = document.getElementById('redoBtn');
    const clearBtn = document.getElementById('clearBtn');
    
    const nativeColor = document.getElementById('nativeColor');
    const hexInput = document.getElementById('hexInput');
    const opacitySlider = document.getElementById('opacitySlider');
    const opacityVal = document.getElementById('opacityVal');
    const recentPalette = document.getElementById('recentPalette');
    
    const timeline = document.getElementById('timeline');
    const addFrameBtn = document.getElementById('addFrameBtn');
    const dupFrameBtn = document.getElementById('dupFrameBtn');
    const delFrameBtn = document.getElementById('delFrameBtn');
    const onionBtn = document.getElementById('onionBtn');
    const playBtn = document.getElementById('playBtn');
    const fpsSelect = document.getElementById('fpsSelect');
    
    const gridSizeSelect = document.getElementById('gridSizeSelect');
    const fileTriggerBtn = document.getElementById('fileTriggerBtn');
    const fileInput = document.getElementById('fileInput');
    const coordDisplay = document.getElementById('coordDisplay');
    const pixelStats = document.getElementById('pixelStats');
    
    const generateSvgBtn = document.getElementById('generateSvgBtn');
    const copySvgBtn = document.getElementById('copySvgBtn');
    const downloadSvgBtn = document.getElementById('downloadSvgBtn');
    const svgOutput = document.getElementById('svgOutput');
    const svgPreviewContainer = document.getElementById('svgPreviewContainer');
    
    const colorReduceCount = document.getElementById('colorReduceCount');
    const reduceColorsBtn = document.getElementById('reduceColorsBtn');
    
    const saveProjBtn = document.getElementById('saveProjBtn');
    const loadProjBtn = document.getElementById('loadProjBtn');
    const projInput = document.getElementById('projInput');
    const toast = document.getElementById('toast');

    // --- INITIALIZATION ---
    function init() {
      resetGrid(24, 24);
      setupEventListeners();
      renderPalette();
      updateUI();
    }

    function createEmptyPixels(w, h) {
      const pixels = [];
      for (let y = 0; y < h; y++) {
        const row = [];
        for (let x = 0; x < w; x++) {
          row.push(null);
        }
        pixels.push(row);
      }
      return pixels;
    }

    function deepCopyPixels(pixels) {
      return pixels.map(row => row.map(cell => cell ? { ...cell } : null));
    }

    function resetGrid(w, h) {
      state.width = w;
      state.height = h;
      state.frames = [createEmptyPixels(w, h)];
      state.activeFrameIndex = 0;
      state.history = [];
      state.historyIndex = -1;
      saveHistory();
      renderAll();
    }

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2000);
    }

    // --- HISTORY (UNDO / REDO) ---
    function saveHistory() {
      if (state.historyIndex < state.history.length - 1) {
        state.history = state.history.slice(0, state.historyIndex + 1);
      }
      const snapshot = deepCopyPixels(state.frames[state.activeFrameIndex]);
      state.history.push(snapshot);
      if (state.history.length > state.maxHistory) {
        state.history.shift();
      } else {
        state.historyIndex++;
      }
    }

    function undo() {
      if (state.historyIndex > 0) {
        state.historyIndex--;
        state.frames[state.activeFrameIndex] = deepCopyPixels(state.history[state.historyIndex]);
        renderAll();
      }
    }

    function redo() {
      if (state.historyIndex < state.history.length - 1) {
        state.historyIndex++;
        state.frames[state.activeFrameIndex] = deepCopyPixels(state.history[state.historyIndex]);
        renderAll();
      }
    }

    // --- RENDERING ---
    function renderAll() {
      renderEditorCanvas();
      renderOnionCanvas();
      renderTimeline();
      updateStats();
    }

    function renderEditorCanvas() {
      editorCanvas.width = state.width;
      editorCanvas.height = state.height;
      editorCtx.clearRect(0, 0, state.width, state.height);

      const pixels = state.frames[state.activeFrameIndex];
      if (!pixels) return;

      for (let y = 0; y < state.height; y++) {
        for (let x = 0; x < state.width; x++) {
          const cell = pixels[y][x];
          if (cell && cell.opacity > 0) {
            editorCtx.fillStyle = cell.color;
            editorCtx.globalAlpha = cell.opacity;
            editorCtx.fillRect(x, y, 1, 1);
          }
        }
      }
      editorCtx.globalAlpha = 1.0;
    }

    function renderOnionCanvas() {
      onionCanvas.width = state.width;
      onionCanvas.height = state.height;
      onionCtx.clearRect(0, 0, state.width, state.height);

      if (!state.onionSkin || state.activeFrameIndex === 0) return;

      const prevPixels = state.frames[state.activeFrameIndex - 1];
      if (!prevPixels) return;

      for (let y = 0; y < state.height; y++) {
        for (let x = 0; x < state.width; x++) {
          const cell = prevPixels[y][x];
          if (cell && cell.opacity > 0) {
            onionCtx.fillStyle = cell.color;
            onionCtx.globalAlpha = cell.opacity * 0.4;
            onionCtx.fillRect(x, y, 1, 1);
          }
        }
      }
      onionCtx.globalAlpha = 1.0;
    }

    function renderTimeline() {
      timeline.innerHTML = '';
      state.frames.forEach((frame, idx) => {
        const thumb = document.createElement('div');
        thumb.className = `frame-thumb ${idx === state.activeFrameIndex ? 'active' : ''}`;
        
        const cvs = document.createElement('canvas');
        cvs.width = state.width;
        cvs.height = state.height;
        const ctx = cvs.getContext('2d');
        
        for (let y = 0; y < state.height; y++) {
          for (let x = 0; x < state.width; x++) {
            const cell = frame[y][x];
            if (cell && cell.opacity > 0) {
              ctx.fillStyle = cell.color;
              ctx.globalAlpha = cell.opacity;
              ctx.fillRect(x, y, 1, 1);
            }
          }
        }

        const num = document.createElement('span');
        num.className = 'frame-num';
        num.textContent = idx + 1;

        thumb.appendChild(cvs);
        thumb.appendChild(num);

        thumb.addEventListener('click', () => {
          state.activeFrameIndex = idx;
          state.history = [];
          state.historyIndex = -1;
          saveHistory();
          renderAll();
        });

        timeline.appendChild(thumb);
      });
    }

    function updateStats() {
      const pixels = state.frames[state.activeFrameIndex];
      let used = 0;
      const total = state.width * state.height;

      if (pixels) {
        for (let y = 0; y < state.height; y++) {
          for (let x = 0; x < state.width; x++) {
            if (pixels[y][x] && pixels[y][x].opacity > 0) used++;
          }
        }
      }

      pixelStats.textContent = `PIXELS: ${used} / ${total}`;
    }

    // --- INTERACTION / DRAWING ---
    let isDrawing = false;

    function getCanvasCoords(e) {
      const rect = editorCanvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      
      const x = Math.floor(((clientX - rect.left) / rect.width) * state.width);
      const y = Math.floor(((clientY - rect.top) / rect.height) * state.height);
      
      return {
        x: Math.max(0, Math.min(state.width - 1, x)),
        y: Math.max(0, Math.min(state.height - 1, y))
      };
    }

    function applyTool(x, y) {
      const currentFrame = state.frames[state.activeFrameIndex];
      
      if (state.activeTool === 'pencil') {
        currentFrame[y][x] = {
          color: state.currentColor,
          opacity: state.currentOpacity
        };
        addRecentColor(state.currentColor);
      } else if (state.activeTool === 'eraser') {
        currentFrame[y][x] = null;
      } else if (state.activeTool === 'picker') {
        const cell = currentFrame[y][x];
        if (cell) {
          state.currentColor = cell.color;
          state.currentOpacity = cell.opacity;
          updateUI();
        }
        return;
      }
      renderEditorCanvas();
      renderTimeline();
      updateStats();
    }

    function handlePointerDown(e) {
      isDrawing = true;
      const { x, y } = getCanvasCoords(e);
      coordDisplay.textContent = `X: ${x} Y: ${y}`;
      applyTool(x, y);
    }

    function handlePointerMove(e) {
      const { x, y } = getCanvasCoords(e);
      coordDisplay.textContent = `X: ${x} Y: ${y}`;
      if (isDrawing && state.activeTool !== 'picker') {
        applyTool(x, y);
      }
    }

    function handlePointerUp() {
      if (isDrawing) {
        isDrawing = false;
        saveHistory();
      }
    }

    // --- PALETTE MANAGEMENT ---
    function addRecentColor(hex) {
      if (!state.recentColors.includes(hex)) {
        state.recentColors.unshift(hex);
        if (state.recentColors.length > 10) state.recentColors.pop();
        renderPalette();
      }
    }

    function renderPalette() {
      recentPalette.innerHTML = '';
      state.recentColors.forEach(color => {
        const swatch = document.createElement('div');
        swatch.className = 'swatch';
        swatch.style.backgroundColor = color;
        swatch.addEventListener('click', () => {
          state.currentColor = color;
          updateUI();
        });
        recentPalette.appendChild(swatch);
      });
    }

    function updateUI() {
      nativeColor.value = state.currentColor;
      hexInput.value = state.currentColor.toUpperCase();
      opacitySlider.value = Math.round(state.currentOpacity * 100);
      opacityVal.textContent = `${opacitySlider.value}%`;

      [pencilBtn, eraserBtn, pickerBtn].forEach(b => b.classList.remove('active'));
      if (state.activeTool === 'pencil') pencilBtn.classList.add('active');
      if (state.activeTool === 'eraser') eraserBtn.classList.add('active');
      if (state.activeTool === 'picker') pickerBtn.classList.add('active');
    }

    // --- IMAGE & SVG IMPORT ---
    function handleFileUpload(file) {
      if (!file) return;

      if (file.type.includes('png') || file.type.includes('image/')) {
        const img = new Image();
        img.onload = () => processImportedImage(img);
        img.src = URL.createObjectURL(file);
      } else if (file.type.includes('svg')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const content = e.target.result;
          if (content.includes('<rect') && content.includes('crispEdges')) {
            // Attempt native SVG parse if created by this app
            if (parseNativeSvg(content)) {
              showToast('Imported Animated SVG');
              return;
            }
          }
          // Fallback rasterize SVG
          const img = new Image();
          img.onload = () => processImportedImage(img);
          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(content);
        };
        reader.readAsText(file);
      }
    }

    function processImportedImage(img) {
      const cvs = document.createElement('canvas');
      cvs.width = state.width;
      cvs.height = state.height;
      const ctx = cvs.getContext('2d');
      ctx.drawImage(img, 0, 0, state.width, state.height);
      
      const imgData = ctx.getImageData(0, 0, state.width, state.height).data;
      const newFrame = createEmptyPixels(state.width, state.height);

      for (let y = 0; y < state.height; y++) {
        for (let x = 0; x < state.width; x++) {
          const idx = (y * state.width + x) * 4;
          const a = imgData[idx + 3] / 255;
          if (a > 0.05) {
            const r = imgData[idx].toString(16).padStart(2, '0');
            const g = imgData[idx + 1].toString(16).padStart(2, '0');
            const b = imgData[idx + 2].toString(16).padStart(2, '0');
            newFrame[y][x] = {
              color: `#${r}${g}${b}`.toUpperCase(),
              opacity: parseFloat(a.toFixed(2))
            };
          }
        }
      }

      state.frames[state.activeFrameIndex] = newFrame;
      saveHistory();
      renderAll();
      showToast('Image Imported');
    }

    function parseNativeSvg(svgString) {
      try {
        const parser = new DOMParser();
        const doc = parser.parseFromString(svgString, 'image/svg+xml');
        const groups = doc.querySelectorAll('g.frame');
        
        if (groups.length === 0) return false;

        const importedFrames = [];
        groups.forEach(g => {
          const frame = createEmptyPixels(state.width, state.height);
          const rects = g.querySelectorAll('rect');
          rects.forEach(r => {
            const x = parseInt(r.getAttribute('x'));
            const y = parseInt(r.getAttribute('y'));
            const fill = r.getAttribute('fill');
            const op = parseFloat(r.getAttribute('fill-opacity') || '1');
            if (x < state.width && y < state.height) {
              frame[y][x] = { color: fill, opacity: op };
            }
          });
          importedFrames.push(frame);
        });

        if (importedFrames.length > 0) {
          state.frames = importedFrames;
          state.activeFrameIndex = 0;
          saveHistory();
          renderAll();
          return true;
        }
      } catch (err) {
        console.error("Native SVG parsing failed:", err);
      }
      return false;
    }

    // --- COLOR REDUCTION ---
    function reduceColors() {
      const maxColors = parseInt(colorReduceCount.value);
      const frame = state.frames[state.activeFrameIndex];
      
      // 1. Collect unique colors
      const colorCounts = {};
      for (let y = 0; y < state.height; y++) {
        for (let x = 0; x < state.width; x++) {
          const cell = frame[y][x];
          if (cell && cell.opacity > 0) {
            colorCounts[cell.color] = (colorCounts[cell.color] || 0) + 1;
          }
        }
      }

      const uniqueHexes = Object.keys(colorCounts);
      if (uniqueHexes.length <= maxColors) {
        showToast('Already within limit');
        return;
      }

      // Simple Palette Selection: Pick top N most used colors
      const palette = uniqueHexes
        .sort((a, b) => colorCounts[b] - colorCounts[a])
        .slice(0, maxColors)
        .map(hex => hexToRgb(hex));

      // 2. Map every pixel to nearest palette color
      for (let y = 0; y < state.height; y++) {
        for (let x = 0; x < state.width; x++) {
          const cell = frame[y][x];
          if (cell && cell.opacity > 0) {
            const rgb = hexToRgb(cell.color);
            cell.color = getClosestColor(rgb, palette);
          }
        }
      }

      saveHistory();
      renderAll();
      showToast('Colors Reduced');
    }

    function hexToRgb(hex) {
      const c = hex.replace('#', '');
      return {
        r: parseInt(c.substring(0, 2), 16),
        g: parseInt(c.substring(2, 4), 16),
        b: parseInt(c.substring(4, 6), 16)
      };
    }

    function getClosestColor(target, palette) {
      let minDistance = Infinity;
      let closest = palette[0];

      palette.forEach(p => {
        const dist = Math.pow(target.r - p.r, 2) + 
                     Math.pow(target.g - p.g, 2) + 
                     Math.pow(target.b - p.b, 2);
        if (dist < minDistance) {
          minDistance = dist;
          closest = p;
        }
      });

      const r = closest.r.toString(16).padStart(2, '0');
      const g = closest.g.toString(16).padStart(2, '0');
      const b = closest.b.toString(16).padStart(2, '0');
      return `#${r}${g}${b}`.toUpperCase();
    }

    // --- SVG GENERATION ---
    function buildSVG() {
      const numFrames = state.frames.length;
      const frameDuration = (1 / state.fps).toFixed(3);
      const totalDuration = (numFrames * frameDuration).toFixed(3);

      let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${state.width} ${state.height}" shape-rendering="crispEdges">\n`;

      if (numFrames === 1) {
        // Static SVG
        const frame = state.frames[0];
        for (let y = 0; y < state.height; y++) {
          for (let x = 0; x < state.width; x++) {
            const cell = frame[y][x];
            if (cell && cell.opacity > 0) {
              const opAttr = cell.opacity < 1 ? ` fill-opacity="${cell.opacity}"` : '';
              svg += `  <rect x="${x}" y="${y}" width="1" height="1" fill="${cell.color}"${opAttr}/>\n`;
            }
          }
        }
      } else {
        // Animated SVG using SMIL keyTimes logic for zero overlap
        state.frames.forEach((frame, idx) => {
          const keyTimes = [];
          const values = [];

          for (let i = 0; i <= numFrames; i++) {
            keyTimes.push((i / numFrames).toFixed(3));
            values.push(i === idx || (i === numFrames && idx === 0) ? 'inline' : 'none');
          }

          // Force discrete steps
          const calcMode = 'calcMode="discrete"';
          
          svg += `  <g class="frame" display="${idx === 0 ? 'inline' : 'none'}">\n`;
          svg += `    <animate attributeName="display" values="${values.join(';')}" keyTimes="${keyTimes.join(';')}" dur="${totalDuration}s" repeatCount="indefinite" ${calcMode}/>\n`;

          for (let y = 0; y < state.height; y++) {
            for (let x = 0; x < state.width; x++) {
              const cell = frame[y][x];
              if (cell && cell.opacity > 0) {
                const opAttr = cell.opacity < 1 ? ` fill-opacity="${cell.opacity}"` : '';
                svg += `    <rect x="${x}" y="${y}" width="1" height="1" fill="${cell.color}"${opAttr}/>\n`;
              }
            }
          }
          svg += `  </g>\n`;
        });
      }

      svg += `</svg>`;
      return svg;
    }

    // --- EVENT LISTENERS ---
    function setupEventListeners() {
      // Canvas Drawing
      editorCanvas.addEventListener('pointerdown', handlePointerDown);
      editorCanvas.addEventListener('pointermove', handlePointerMove);
      window.addEventListener('pointerup', handlePointerUp);

      // Tool Switchers
      pencilBtn.addEventListener('click', () => { state.activeTool = 'pencil'; updateUI(); });
      eraserBtn.addEventListener('click', () => { state.activeTool = 'eraser'; updateUI(); });
      pickerBtn.addEventListener('click', () => { state.activeTool = 'picker'; updateUI(); });

      // Actions
      undoBtn.addEventListener('click', undo);
      redoBtn.addEventListener('click', redo);
      clearBtn.addEventListener('click', () => {
        state.frames[state.activeFrameIndex] = createEmptyPixels(state.width, state.height);
        saveHistory();
        renderAll();
      });

      // Color System Inputs
      nativeColor.addEventListener('input', (e) => {
        state.currentColor = e.target.value.toUpperCase();
        hexInput.value = state.currentColor;
      });

      hexInput.addEventListener('change', (e) => {
        let val = e.target.value;
        if (!val.startsWith('#')) val = '#' + val;
        if (/^#[0-9A-F]{6}$/i.test(val)) {
          state.currentColor = val.toUpperCase();
          nativeColor.value = state.currentColor;
        } else {
          hexInput.value = state.currentColor;
        }
      });

      opacitySlider.addEventListener('input', (e) => {
        state.currentOpacity = parseInt(e.target.value) / 100;
        opacityVal.textContent = `${e.target.value}%`;
      });

      // Frame Controls
      addFrameBtn.addEventListener('click', () => {
        state.frames.push(createEmptyPixels(state.width, state.height));
        state.activeFrameIndex = state.frames.length - 1;
        saveHistory();
        renderAll();
      });

      dupFrameBtn.addEventListener('click', () => {
        const copy = deepCopyPixels(state.frames[state.activeFrameIndex]);
        state.frames.splice(state.activeFrameIndex + 1, 0, copy);
        state.activeFrameIndex++;
        saveHistory();
        renderAll();
      });

      delFrameBtn.addEventListener('click', () => {
        if (state.frames.length <= 1) {
          showToast('Cannot delete last frame');
          return;
        }
        state.frames.splice(state.activeFrameIndex, 1);
        if (state.activeFrameIndex >= state.frames.length) {
          state.activeFrameIndex = state.frames.length - 1;
        }
        saveHistory();
        renderAll();
      });

      onionBtn.addEventListener('click', () => {
        state.onionSkin = !state.onionSkin;
        onionBtn.textContent = `Onion: ${state.onionSkin ? 'ON' : 'OFF'}`;
        onionBtn.classList.toggle('active', state.onionSkin);
        renderOnionCanvas();
      });

      // Animation Playback
      playBtn.addEventListener('click', () => {
        if (state.isPlaying) {
          clearInterval(state.playInterval);
          state.isPlaying = false;
          playBtn.textContent = 'Play';
          renderAll();
        } else {
          state.isPlaying = true;
          playBtn.textContent = 'Pause';
          const intervalMs = 1000 / state.fps;
          state.playInterval = setInterval(() => {
            state.activeFrameIndex = (state.activeFrameIndex + 1) % state.frames.length;
            renderEditorCanvas();
            renderTimeline();
          }, intervalMs);
        }
      });

      fpsSelect.addEventListener('change', (e) => {
        state.fps = parseInt(e.target.value);
        if (state.isPlaying) {
          playBtn.click();
          playBtn.click();
        }
      });

      // Grid Size
      gridSizeSelect.addEventListener('change', (e) => {
        const size = parseInt(e.target.value);
        if (confirm('Changing grid size will clear your artwork. Continue?')) {
          resetGrid(size, size);
        } else {
          gridSizeSelect.value = state.width;
        }
      });

      // Import File Trigger
      fileTriggerBtn.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
          handleFileUpload(e.target.files[0]);
        }
      });

      // Color Reduction
      reduceColorsBtn.addEventListener('click', reduceColors);

      // SVG Generation & Output
      generateSvgBtn.addEventListener('click', () => {
        const svgStr = buildSVG();
        svgOutput.value = svgStr;
        svgPreviewContainer.innerHTML = svgStr;
        showToast('SVG Generated');
      });

      copySvgBtn.addEventListener('click', () => {
        if (!svgOutput.value) generateSvgBtn.click();
        navigator.clipboard.writeText(svgOutput.value)
          .then(() => showToast('SVG COPIED'))
          .catch(() => showToast('Failed to copy'));
      });

      downloadSvgBtn.addEventListener('click', () => {
        if (!svgOutput.value) generateSvgBtn.click();
        const blob = new Blob([svgOutput.value], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'pixel-animation.svg';
        a.click();
        URL.revokeObjectURL(url);
      });

      // Project Save / Load
      saveProjBtn.addEventListener('click', () => {
        const projectData = {
          width: state.width,
          height: state.height,
          fps: state.fps,
          frames: state.frames
        };
        const blob = new Blob([JSON.stringify(projectData)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'pixel-svg-project.json';
        a.click();
        URL.revokeObjectURL(url);
      });

      loadProjBtn.addEventListener('click', () => projInput.click());
      projInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const data = JSON.parse(evt.target.result);
            if (data.width && data.height && data.frames) {
              state.width = data.width;
              state.height = data.height;
              state.fps = data.fps || 10;
              state.frames = data.frames;
              state.activeFrameIndex = 0;
              gridSizeSelect.value = state.width;
              fpsSelect.value = state.fps;
              saveHistory();
              renderAll();
              showToast('Project Loaded');
            }
          } catch (err) {
            showToast('Invalid Project File');
          }
        };
        reader.readAsText(file);
      });
    }

    // Start App
    init();
  </script>
</body>
</html>
